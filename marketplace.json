        "name": "OXI",
        "github": "OXI-717"
      },
      "tags": [
        "agents",
        "accounts"
      ],
      "source": {
        "git": {
          "url": "https://github.com/OXI-717/bb-plugins.git",
          "subdir": "plugins/account-pool-balanced",
          "range": "^0.4.78",
          "tagPrefix": "account-pool-balanced/"
        }
      }
    },
    {
      "id": "automation-catalog",
      "icon": {
        "url": "./icons/automation-catalog.svg"
